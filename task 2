matrix = [
    [0, 0, 0],
    [0, 0, 0],
    [0, 0, 0]
]

source = (0, 0)
destination = (1, 2)

paths = []

def find_paths(current, path):
    if current == destination:
        paths.append(path.copy())
        return

    x, y = current
    target_x, target_y = destination

    if x < target_x:
        find_paths((x + 1, y), path + [(x + 1, y)])

    if y < target_y:
        find_paths((x, y + 1), path + [(x, y + 1)])

find_paths(source, [source])

print("All possible paths:")

for i, path in enumerate(paths, 1):
    distance = len(path) - 1
    print("Path", i, ":", end=" ")
    print(" -> ".join(str(position) for position in path))
    print("Distance:", distance)

