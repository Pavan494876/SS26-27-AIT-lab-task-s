import heapq


def h(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])


def astar(grid, start, goal):
    q = [(h(start, goal), 0, start, [start])]
    cost = {start: 0}

    while q:
       
        f, g, p, path = heapq.heappop(q)

       
        if p == goal:
            return path, g

        for dx, dy in [(1, 0), (-1, 0), (0, 1), (0, -1)]:
            x, y = p[0] + dx, p[1] + dy

            
            if (0 <= x < len(grid) and
                0 <= y < len(grid[0]) and
                grid[x][y] == 0):

                ng = g + 1

                if (x, y) not in cost or ng < cost[(x, y)]:
                    cost[(x, y)] = ng
                    f_score = ng + h((x, y), goal)

                    heapq.heappush(
                        q,
                        (f_score, ng, (x, y), path + [(x, y)])
                    )

    return None, float('inf')



grid = [
    [0, 0, 0],
    [0, 1, 0],
    [0, 0, 0]
]

start = (0, 0)
goal = (2, 2)


optimal, total_cost = astar(grid, start, goal)


print("input grid")
for row in grid:
    print(row)

print("start:", start)
print("goal:", goal)
print("optimal path:", optimal)
print("cost:", total_cost)

